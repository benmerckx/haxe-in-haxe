class SelfDispatcher extends Dispatcher {
	final s:IScheduler;

	/**
		Creates a new `SelfDispatcher`.
	**/
	public function new(scheduler:IScheduler) {
		s = scheduler;
	}

	function get_scheduler() {
		return s;
	}

	/**
		@see `Dispatcher.dispatch`
