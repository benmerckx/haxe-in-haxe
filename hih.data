	var EXCL = 4;
	var EXLOCK = 5;
	var NOCTTY = 6;
	var NOFOLLOW = 7;
	var TEMPORARY = 8;
	var TRUNC = 9;
	var APPEND = 10;
	var DIRECT = 11;
	var DSYNC = 12;
	var FILEMAP = 13;
	var NOATIME = 14;
	var NONBLOCK = 15;
	var RANDOM = 16;
	var SEQUENTIAL = 17;
	var SHORT_LIVED = 18;
	var SYMLINK = 19;
	var SYNC = 20;
