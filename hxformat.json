{
	"excludes": [
		"\\.haxelib",
		"\\.git",
		"node_modules"
	],
	"indentation": {
		"character": "tab",
		"tabWidth": 4,
		"conditionalPolicy": "aligned"
	},
	"wrapping": {
		"maxLineLength": 140
	},
	"sameLine": {
		"ifBody": "keep",
		"elseBody": "keep",
		"forBody": "keep",
		"whileBody": "keep",
		"caseBody": "next",
		"catchBody": "keep",
		"tryBody": "keep",
		"doWhileBody": "keep",
		"functionBody": "keep"
	}
}
