**/
@:using(eval.luv.Handle)
@:coreType abstract Udp to Handle to Handle.SocketHandle {
	/**
		Allocates and initializes a UDP socket.

		The handle should be cleaned up with `eval.luv.Handle.close` when no longer needed.
	**/
