package core;

import core.Message.WarningCode;

// Translation of WarningList generated by haxe/src/prebuild.ml from src-json/warning.json.
// Warning codes retain the string representation used by Message.
@:structInit class WarningDescription {
	public var wName:String;
	public var wDoc:String;
	public var wGeneric:Bool;
	public var wParent:Null<WarningCode>;

	public inline function new(wName:String, wDoc:String, wGeneric:Bool, wParent:Null<WarningCode>) {
		this.wName = wName;
		this.wDoc = wDoc;
		this.wGeneric = wGeneric;
		this.wParent = wParent;
	}

	public inline function clone():WarningDescription return new WarningDescription(wName, wDoc, wGeneric, wParent);
}

class WarningParseFailure {
	public function new() {}
}

class WarningList {
	public static function fromString(s:String):WarningCode return switch s {
		case "WAll": cast "WAll";
		case "WInternal": cast "WInternal";
		case "WTemp": cast "WTemp";
		case "WInfo": cast "WInfo";
		case "WUser": cast "WUser";
		case "WCompiler": cast "WCompiler";
		case "WParser": cast "WParser";
		case "WTyper": cast "WTyper";
		case "WMacro": cast "WMacro";
		case "WOptimizer": cast "WOptimizer";
		case "WGenerator": cast "WGenerator";
		case "WNullSafety": cast "WNullSafety";
		case "WDeprecated": cast "WDeprecated";
		case "WDeprecatedDefine": cast "WDeprecatedDefine";
		case "WDeprecatedEnumAbstract": cast "WDeprecatedEnumAbstract";
		case "WVarInit": cast "WVarInit";
		case "WVarShadow": cast "WVarShadow";
		case "WExternWithExpr": cast "WExternWithExpr";
		case "WStaticInitOrder": cast "WStaticInitOrder";
		case "WClosureCompare": cast "WClosureCompare";
		case "WReservedTypePath": cast "WReservedTypePath";
		case "WInlineOptimizedField": cast "WInlineOptimizedField";
		case "WPatternMatcher": cast "WPatternMatcher";
		case "WUnusedPattern": cast "WUnusedPattern";
		case "WConstructorInliningCancelled": cast "WConstructorInliningCancelled";
		case "WUnsafeEnumEquality": cast "WUnsafeEnumEquality";
		case "WIfDisplay": cast "WIfDisplay";
		case "WRedundantNullCheck": cast "WRedundantNullCheck";
		case "WHxb": cast "WHxb";
		case "WIgnoredBadModule": cast "WIgnoredBadModule";
		case "WUnboundTypeParameter": cast "WUnboundTypeParameter";
		case "WUnclosedMonomorph": cast "WUnclosedMonomorph";
		case "WPointlessCode": cast "WPointlessCode";
		case _: throw new WarningParseFailure();
	};

	public static function warningObj(w:WarningCode):WarningDescription return switch (cast w : String) {
		case "WAll": {
				wName: "WAll",
				wDoc: "The mother of all warnings",
				wGeneric: true,
				wParent: null
			};
		case "WInternal": {
				wName: "WInternal",
				wDoc: "Reserved for internal use",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WTemp": {
				wName: "WTemp",
				wDoc: "Reserved for internal use",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WInfo": {
				wName: "WInfo",
				wDoc: "Generic information like $type",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WUser": {
				wName: "WUser",
				wDoc: "Custom user warnings, e.g. from Context.warning",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WCompiler": {
				wName: "WCompiler",
				wDoc: "Warnings from the compiler frontend, e.g. argument parsing",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WParser": {
				wName: "WParser",
				wDoc: "Warnings related to lexing and parsing",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WTyper": {
				wName: "WTyper",
				wDoc: "Warnings from the typer",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WMacro": {
				wName: "WMacro",
				wDoc: "Warning related to macros",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WOptimizer": {
				wName: "WOptimizer",
				wDoc: "Warnings related to optimization",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WGenerator": {
				wName: "WGenerator",
				wDoc: "Warnings related to code generation",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WNullSafety": {
				wName: "WNullSafety",
				wDoc: "Warnings related to null safety",
				wGeneric: true,
				wParent: cast "WAll"
			};
		case "WDeprecated": {
				wName: "WDeprecated",
				wDoc: "This is deprecated and should no longer be used",
				wGeneric: false,
				wParent: cast "WAll"
			};
		case "WDeprecatedDefine": {
				wName: "WDeprecatedDefine",
				wDoc: "This define is deprecated and should no longer be used",
				wGeneric: false,
				wParent: cast "WDeprecated"
			};
		case "WDeprecatedEnumAbstract": {
				wName: "WDeprecatedEnumAbstract",
				wDoc: "`@:enum abstract` is deprecated, `enum abstract` should be used instead",
				wGeneric: false,
				wParent: cast "WDeprecated"
			};
		case "WVarInit": {
				wName: "WVarInit",
				wDoc: "A local variable might be used before being assigned a value",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WVarShadow": {
				wName: "WVarShadow",
				wDoc: "A local variable hides another by using the same name",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WExternWithExpr": {
				wName: "WExternWithExpr",
				wDoc: "A non-inline field marked as extern has an expression",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WStaticInitOrder": {
				wName: "WStaticInitOrder",
				wDoc: "The compiler could not determine a type order due to mutually dependent static initializations",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WClosureCompare": {
				wName: "WClosureCompare",
				wDoc: "Closures are being compared, which might be undefined",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WReservedTypePath": {
				wName: "WReservedTypePath",
				wDoc: "A type path is being used that is supposed to be reserved on the current target",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WInlineOptimizedField": {
				wName: "WInlineOptimizedField",
				wDoc: "A cached field which was optimized might lead to different output when inlined",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WPatternMatcher": {
				wName: "WPatternMatcher",
				wDoc: "Warnings related to the pattern matcher",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WUnusedPattern": {
				wName: "WUnusedPattern",
				wDoc: "The pattern is not used because previous cases cover",
				wGeneric: false,
				wParent: cast "WPatternMatcher"
			};
		case "WConstructorInliningCancelled": {
				wName: "WConstructorInliningCancelled",
				wDoc: "Constructor call could not be inlined because a field is uninitialized",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WUnsafeEnumEquality": {
				wName: "WUnsafeEnumEquality",
				wDoc: "Equality operations on enums with parameters might not work as expected",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case "WIfDisplay": {
				wName: "WIfDisplay",
				wDoc: "Using `display` here doesn't work because #if conditions are evaluated at parse time. In macros, use `haxe.macro.Context.defined(\"display\")` instead.",
				wGeneric: false,
				wParent: cast "WParser"
			};
		case "WRedundantNullCheck": {
				wName: "WRedundantNullCheck",
				wDoc: "Value can't be null, so comparison with null is excessive",
				wGeneric: false,
				wParent: cast "WNullSafety"
			};
		case "WHxb": {
				wName: "WHxb",
				wDoc: "Hxb (either --hxb output or haxe compiler cache) related warnings",
				wGeneric: false,
				wParent: cast "WAll"
			};
		case "WIgnoredBadModule": {
				wName: "WIgnoredBadModule",
				wDoc: "An invalidated module has been ignored during a display request",
				wGeneric: false,
				wParent: cast "WHxb"
			};
		case "WUnboundTypeParameter": {
				wName: "WUnboundTypeParameter",
				wDoc: "Hxb (either --hxb output or haxe compiler cache) failed to link a type parameter to an actual type",
				wGeneric: false,
				wParent: cast "WHxb"
			};
		case "WUnclosedMonomorph": {
				wName: "WUnclosedMonomorph",
				wDoc: "Hxb writer failed to close a monomorph (that monomorph should have been closed in the first place)",
				wGeneric: false,
				wParent: cast "WHxb"
			};
		case "WPointlessCode": {
				wName: "WPointlessCode",
				wDoc: "Expression or code block has no effect",
				wGeneric: false,
				wParent: cast "WTyper"
			};
		case _: throw new WarningParseFailure();
	};

	public static final disabledWarnings:Array<WarningCode> = [cast "WVarShadow", cast "WUnsafeEnumEquality", cast "WRedundantNullCheck"];
}
