/**
	Synchronous version of `eval.luv.File` API
**/
extern class FileSync {
	@:inheritDoc(eval.luv.File.open)
	static function open(path:NativeString, flags:Array<FileOpenFlag>, ?mode:Array<FileMode>):Result<File>;

