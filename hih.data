	IWUSR;
	IXUSR;
	IRWXG;
	IRGRP;
	IWGRP;
	IXGRP;
	IRWXO;
	IROTH;
	IWOTH;
	IXOTH;
	ISUID;
	ISGID;
	ISVTX;
	IFMT;
	IFREG;
	IFDIR;
	IFBLK;
	IFCHR;
	IFLNK;
	IFIFO;
