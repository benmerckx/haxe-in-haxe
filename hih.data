	var nlink:UInt64;
	var uid:UInt64;
	var gid:UInt64;
	var rdev:UInt64;
	var ino:UInt64;
	var size:UInt64;
	var blksize:UInt64;
	var blocks:UInt64;
	var flags:UInt64;
	var gen:UInt64;
	var atim:FileStatTimeSpec;
	var mtim:FileStatTimeSpec;
	var ctim:FileStatTimeSpec;
	var birthtim:FileStatTimeSpec;
}

typedef FileStatFs = {
	var type:UInt64;
	var bsize:UInt64;
	var blocks:UInt64;
	var bfree:UInt64;
	var bavail:UInt64;
	var files:UInt64;
	var ffree:UInt64;
